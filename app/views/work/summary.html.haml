.summary-controls
  = link_to t('.back_to_work'), work_path, class: 'btn btn-primary'

%hr

.summary-table-container
  %table.table.table-striped.table-hover
    %thead
      %tr
        %th= t('.image_name')
        %th= t('.image_preview')
        %th= t('.theme')
        %th= t('.average_rating')
        %th= t('.ratings_count')
        %th= t('.last_rated')
    %tbody
      - if @images.present? && @images.any?
        - @images.each do |image|
          %tr
            %td.image-name= image.name
            %td.image-preview
              - if image.file.present?
                = image_tag "/assets/pictures/#{image.file}", size: "80x80", class: "img-thumbnail"
              - else
                = t('.no_image')
            %td= image.theme&.name || 'Без темы'
            %td.average-value
              - if image.ave_value.to_f > 0
                %span.badge.badge-info= image.ave_value.round(1)
              - else
                = t('.no_ratings')
            %td= image.values.count
            %td
              - last_rated_at = image.values.maximum(:created_at)
              - if last_rated_at.present?
                = last_rated_at.in_time_zone('Europe/Moscow').strftime("%d.%m.%Y %H:%M")
              - else
                = t('.not_rated_yet')
      - else
        %tr
          %td{colspan: 6, style: "text-align: center;"}= t('.no_images')

  = paginate @images