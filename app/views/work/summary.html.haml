.summary-controls
  = link_to t('.back_to_work'), work_path, class: 'btn btn-primary'

%hr

.summary-table-container
  %table.table.table-striped.table-hover
    %thead
      %tr
        %th= t('.image_name')
        %th= t('.image_preview')
        %th= t('.theme')
        %th= t('.average_rating')
        %th= t('.ratings_count')
        %th= t('.last_rated')
    %tbody
      - if @images_with_details.any?
        - @images_with_details.each do |image|
          %tr
            %td.image-name= image[:name]
            %td.image-preview
              - if image[:file].present?
                = image_tag "/assets/pictures/#{image[:file]}", size: "80x80", class: "img-thumbnail"
              - else
                = t('.no_image')
            %td= image[:theme_name]
            %td.average-value
              - if image[:average_value] > 0
                %span.badge.badge-info= image[:average_value].round(1)
              - else
                = t('.no_ratings')
            %td= image[:values_count]
            %td
              - if image[:last_rated_at].present?
                = image[:last_rated_at].strftime("%d.%m.%Y %H:%M")
              - else
                = t('.not_rated_yet')
      - else
        %tr
          %td{colspan: 6, style: "text-align: center;"}= t('.no_images')

